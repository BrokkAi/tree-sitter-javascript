{
  "name": "tree-sitter-javascript",
  "version": "0.25.1",
  "description": "Brokk-maintained Tree-sitter grammar for JavaScript",
  "repository": "https://github.com/BrokkAi/tree-sitter-javascript",
  "license": "MIT",
  "author": {
    "name": "Max Brunsfeld",
    "email": "maxbrunsfeld@gmail.com"
  },
  "maintainers": [
    {
      "name": "Brokk"
    }
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "javascript"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "8.5.0",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "eslint": "9.34.0",
    "eslint-config-treesitter": "1.0.2",
    "prebuildify": "6.0.1",
    "tree-sitter-cli": "0.25.8"
  },
  "peerDependencies": {
    "tree-sitter": "0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/BrokkAi/tree-sitter-javascript/issues"
  },
  "homepage": "https://github.com/BrokkAi/tree-sitter-javascript#readme",
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
